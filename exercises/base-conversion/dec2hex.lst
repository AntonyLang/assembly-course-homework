                                include dosio.inc
                              C ; 8086 DOS helpers. Call after initializing DS to @data.
                              C ; Input routines expect valid input in the range documented by each program.
                              C 
                              C ; Print the unsigned word in AX as decimal. Preserve general registers.
0029                          C print_decimal proc near
0029 53                       C     push bx
002A BB0A00                   C     mov bx, 10
002D E80B00                   C     call print_unsigned
0030 5B                       C     pop bx
0031 C3                       C     ret
0032                          C print_decimal endp
                              C 
                              C ; Print the unsigned word in AX in uppercase hexadecimal, no prefix.
0032                          C print_hex proc near
0032 53                       C     push bx
0033 BB1000                   C     mov bx, 16
0036 E80200                   C     call print_unsigned
0039 5B                       C     pop bx
003A C3                       C     ret
003B                          C print_hex endp
                              C 
                              C ; AX=value, BX=base (10 or 16). Remainders are reversed on the stack.
003B                          C print_unsigned proc near
003B 50                       C     push ax
003C 51                       C     push cx
003D 52                       C     push dx
003E 33C9                     C     xor cx, cx
0040                          C divide_digit:
0040 33D2                     C     xor dx, dx             ; DIV uses DX:AX, not AX alone.
0042 F7F3                     C     div bx                 ; AX=quotient, DX=remainder.
0044 52                       C     push dx
0045 41                       C     inc cx
0046 83F800                   C     cmp ax, 0
0049 75F5                     C     jne divide_digit       ; Execute at least once, so zero prints as "0".
004B                          C output_digit:
004B 5A                       C     pop dx
004C 80FA09                   C     cmp dl, 9
004F 7605                     C     jbe numeric_digit
0051 80C237                   C     add dl, 'A'-10         ; Values 10..15 map to A..F.
0054 EB03                     C     jmp short emit_digit
0056                          C numeric_digit:
0056 80C230                   C     add dl, '0'
0059                          C emit_digit:
0059 B402                     C     mov ah, 02h
005B CD21                     C     int 21h
005D E2EC                     C     loop output_digit
005F 5A                       C     pop dx
0060 59                       C     pop cx
0061 58                       C     pop ax
0062 C3                       C     ret
0063                          C print_unsigned endp
                              C 
0063                          C print_newline proc near
0063 50                       C     push ax
0064 52                       C     push dx
0065 B20D                     C     mov dl, 0dh
0067 B402                     C     mov ah, 02h
0069 CD21                     C     int 21h
006B B20A                     C     mov dl, 0ah
006D CD21                     C     int 21h
006F 5A                       C     pop dx
0070 58                       C     pop ax
0071 C3                       C     ret
0072                          C print_newline endp
                              C 
                              C ; DS:DX points to a DOS AH=0Ah line buffer.
                              C ; Return its unsigned decimal value (0..65535) in AX.
0072                          C read_decimal proc near
0072 B40A                     C     mov ah, 0ah
0074 CD21                     C     int 21h
0076 8BF2                     C     mov si, dx
0078 33C9                     C     xor cx, cx
007A 8A4C01                   C     mov cl, [si+1]         ; Number of input characters, excluding CR.
007D 83C602                   C     add si, 2
0080 33C0                     C     xor ax, ax
0082 BB0A00                   C     mov bx, 10
0085                          C read_digit:
0085 F7E3                     C     mul bx                 ; value = old value * 10 + next digit.
0087 33D2                     C     xor dx, dx
0089 8A14                     C     mov dl, [si]
008B 80EA30                   C     sub dl, '0'
008E 03C2                     C     add ax, dx
0090 46                       C     inc si
0091 E2F2                     C     loop read_digit
0093 C3                       C     ret
0094                          C read_decimal endp
                                end start


