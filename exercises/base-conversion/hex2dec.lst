                                include dosio.inc
                              C ; 8086 DOS helpers. Call after initializing DS to @data.
                              C ; Input routines expect valid input in the range documented by each program.
                              C 
                              C ; Print the unsigned word in AX as decimal. Preserve general registers.
0052                          C print_decimal proc near
0052 53                       C     push bx
0053 BB0A00                   C     mov bx, 10
0056 E80B00                   C     call print_unsigned
0059 5B                       C     pop bx
005A C3                       C     ret
005B                          C print_decimal endp
                              C 
                              C ; Print the unsigned word in AX in uppercase hexadecimal, no prefix.
005B                          C print_hex proc near
005B 53                       C     push bx
005C BB1000                   C     mov bx, 16
005F E80200                   C     call print_unsigned
0062 5B                       C     pop bx
0063 C3                       C     ret
0064                          C print_hex endp
                              C 
                              C ; AX=value, BX=base (10 or 16). Remainders are reversed on the stack.
0064                          C print_unsigned proc near
0064 50                       C     push ax
0065 51                       C     push cx
0066 52                       C     push dx
0067 33C9                     C     xor cx, cx
0069                          C divide_digit:
0069 33D2                     C     xor dx, dx             ; DIV uses DX:AX, not AX alone.
006B F7F3                     C     div bx                 ; AX=quotient, DX=remainder.
006D 52                       C     push dx
006E 41                       C     inc cx
006F 83F800                   C     cmp ax, 0
0072 75F5                     C     jne divide_digit       ; Execute at least once, so zero prints as "0".
0074                          C output_digit:
0074 5A                       C     pop dx
0075 80FA09                   C     cmp dl, 9
0078 7605                     C     jbe numeric_digit
007A 80C237                   C     add dl, 'A'-10         ; Values 10..15 map to A..F.
007D EB03                     C     jmp short emit_digit
007F                          C numeric_digit:
007F 80C230                   C     add dl, '0'
0082                          C emit_digit:
0082 B402                     C     mov ah, 02h
0084 CD21                     C     int 21h
0086 E2EC                     C     loop output_digit
0088 5A                       C     pop dx
0089 59                       C     pop cx
008A 58                       C     pop ax
008B C3                       C     ret
008C                          C print_unsigned endp
                              C 
008C                          C print_newline proc near
008C 50                       C     push ax
008D 52                       C     push dx
008E B20D                     C     mov dl, 0dh
0090 B402                     C     mov ah, 02h
0092 CD21                     C     int 21h
0094 B20A                     C     mov dl, 0ah
0096 CD21                     C     int 21h
0098 5A                       C     pop dx
0099 58                       C     pop ax
009A C3                       C     ret
009B                          C print_newline endp
                              C 
                              C ; DS:DX points to a DOS AH=0Ah line buffer.
                              C ; Return its unsigned decimal value (0..65535) in AX.
009B                          C read_decimal proc near
009B B40A                     C     mov ah, 0ah
009D CD21                     C     int 21h
009F 8BF2                     C     mov si, dx
00A1 33C9                     C     xor cx, cx
00A3 8A4C01                   C     mov cl, [si+1]         ; Number of input characters, excluding CR.
00A6 83C602                   C     add si, 2
00A9 33C0                     C     xor ax, ax
00AB BB0A00                   C     mov bx, 10
00AE                          C read_digit:
00AE F7E3                     C     mul bx                 ; value = old value * 10 + next digit.
00B0 33D2                     C     xor dx, dx
00B2 8A14                     C     mov dl, [si]
00B4 80EA30                   C     sub dl, '0'
00B7 03C2                     C     add ax, dx
00B9 46                       C     inc si
00BA E2F2                     C     loop read_digit
00BC C3                       C     ret
00BD                          C read_decimal endp
