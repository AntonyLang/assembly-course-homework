JWasm v2.20, Oct  9 2026
ascii_loop.asm
                                ; Homework 2 (1): print a-z, 13 letters per line, using nested LOOP.
                                ; MASM-compatible 8086 DOS source. Comments are ASCII for old assemblers.
                                .8086
                                .model small
                                .stack 100h

0000                            .data
0000 0D0A24                         newline db 0dh, 0ah, '$'

0000                            .code
0000                            start:
0000 B8 0000s                       mov ax, DGROUP
0003 8ED8                           mov ds, ax              ; AH=09h requires DS:DX to address the string.
0005 B361                           mov bl, 'a'             ; BL keeps the next letter across space/newline output.
0007 B90200                         mov cx, 2               ; Outer loop: two rows.

000A                            row_loop:
000A 51                             push cx                 ; Save outer CX BEFORE starting the inner loop.
000B B90D00                         mov cx, 13              ; Inner loop: thirteen letters.

000E                            column_loop:
000E 8AD3                           mov dl, bl
0010 B402                           mov ah, 02h             ; DOS function 02h: output the character in DL.
0012 CD21                           int 21h
0014 FEC3                           inc bl                  ; Advance from a through z; do not restart each row.

0016 83F901                         cmp cx, 1
0019 7406                           je no_space             ; Do not append a space after the last letter.
001B B220                           mov dl, ' '
001D B402                           mov ah, 02h
001F CD21                           int 21h

0021                            no_space:
0021 E2EB                           loop column_loop        ; CX = CX - 1; jump if CX != 0 (flags unchanged).

0023 BA 0000o                       mov dx, offset newline
0026 B409                           mov ah, 09h             ; Output CR, LF; '$' terminates the string.
0028 CD21                           int 21h
002A 59                             pop cx                  ; Restore outer CX after the inner loop exhausted it.
002B E2DD                           loop row_loop           ; Outer CX: 2 -> 1 -> 0.

002D B8004C                         mov ax, 4c00h           ; DOS function 4Ch: exit with status 0.
0030 CD21                           int 21h
                                end start


