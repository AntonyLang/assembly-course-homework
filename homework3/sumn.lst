                                include dosio.inc
                              C ; 8086 DOS helpers. Call after initializing DS to @data.
                              C ; Input routines expect valid input in the range documented by each program.
                              C 
                              C ; Print the unsigned word in AX as decimal. Preserve general registers.
0035                          C print_decimal proc near
0035 53                       C     push bx
0036 BB0A00                   C     mov bx, 10
0039 E80B00                   C     call print_unsigned
003C 5B                       C     pop bx
003D C3                       C     ret
003E                          C print_decimal endp
                              C 
                              C ; Print the unsigned word in AX in uppercase hexadecimal, no prefix.
003E                          C print_hex proc near
003E 53                       C     push bx
003F BB1000                   C     mov bx, 16
0042 E80200                   C     call print_unsigned
0045 5B                       C     pop bx
0046 C3                       C     ret
0047                          C print_hex endp
                              C 
                              C ; AX=value, BX=base (10 or 16). Remainders are reversed on the stack.
0047                          C print_unsigned proc near
0047 50                       C     push ax
0048 51                       C     push cx
0049 52                       C     push dx
004A 33C9                     C     xor cx, cx
004C                          C divide_digit:
004C 33D2                     C     xor dx, dx             ; DIV uses DX:AX, not AX alone.
004E F7F3                     C     div bx                 ; AX=quotient, DX=remainder.
0050 52                       C     push dx
0051 41                       C     inc cx
0052 83F800                   C     cmp ax, 0
0055 75F5                     C     jne divide_digit       ; Execute at least once, so zero prints as "0".
0057                          C output_digit:
0057 5A                       C     pop dx
0058 80FA09                   C     cmp dl, 9
005B 7605                     C     jbe numeric_digit
005D 80C237                   C     add dl, 'A'-10         ; Values 10..15 map to A..F.
0060 EB03                     C     jmp short emit_digit
0062                          C numeric_digit:
0062 80C230                   C     add dl, '0'
0065                          C emit_digit:
0065 B402                     C     mov ah, 02h
0067 CD21                     C     int 21h
0069 E2EC                     C     loop output_digit
006B 5A                       C     pop dx
006C 59                       C     pop cx
006D 58                       C     pop ax
006E C3                       C     ret
006F                          C print_unsigned endp
                              C 
006F                          C print_newline proc near
