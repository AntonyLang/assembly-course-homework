007E                          C print_newline endp
                              C 
                              C ; DS:DX points to a DOS AH=0Ah line buffer.
                              C ; Return its unsigned decimal value (0..65535) in AX.
007E                          C read_decimal proc near
007E B40A                     C     mov ah, 0ah
0080 CD21                     C     int 21h
0082 8BF2                     C     mov si, dx
0084 33C9                     C     xor cx, cx
0086 8A4C01                   C     mov cl, [si+1]         ; Number of input characters, excluding CR.
0089 83C602                   C     add si, 2
008C 33C0                     C     xor ax, ax
008E BB0A00                   C     mov bx, 10
0091                          C read_digit:
0091 F7E3                     C     mul bx                 ; value = old value * 10 + next digit.
0093 33D2                     C     xor dx, dx
0095 8A14                     C     mov dl, [si]
0097 80EA30                   C     sub dl, '0'
009A 03C2                     C     add ax, dx
009C 46                       C     inc si
009D E2F2                     C     loop read_digit
009F C3                       C     ret
00A0                          C read_decimal endp
