                                ; Basic sum 1..100. Keep the running total in register AX.
                                .8086
                                .model small
                                .stack 100h
0000                            .data
0000 00                             unused db 0
0000                            .code
0000                            start:
0000 B8 0000s                       mov ax, DGROUP
0003 8ED8                           mov ds, ax
0005 33C0                           xor ax, ax
0007 BB0100                         mov bx, 1
000A B96400                         mov cx, 100
000D                            sum_loop:
000D 03C3                           add ax, bx
000F 43                             inc bx
0010 E2FB                           loop sum_loop
0012 E80800                         call print_decimal
0015 E83F00                         call print_newline
0018 B8004C                         mov ax, 4c00h
001B CD21                           int 21h
                                include dosio.inc
                              C ; 8086 DOS helpers. Call after initializing DS to @data.
                              C ; Input routines expect valid input in the range documented by each program.
                              C 
                              C ; Print the unsigned word in AX as decimal. Preserve general registers.
001D                          C print_decimal proc near
001D 53                       C     push bx
001E BB0A00                   C     mov bx, 10
0021 E80B00                   C     call print_unsigned
0024 5B                       C     pop bx
0025 C3                       C     ret
0026                          C print_decimal endp
                              C 
                              C ; Print the unsigned word in AX in uppercase hexadecimal, no prefix.
0026                          C print_hex proc near
0026 53                       C     push bx
0027 BB1000                   C     mov bx, 16
002A E80200                   C     call print_unsigned
002D 5B                       C     pop bx
002E C3                       C     ret
002F                          C print_hex endp
                              C 
                              C ; AX=value, BX=base (10 or 16). Remainders are reversed on the stack.
002F                          C print_unsigned proc near
002F 50                       C     push ax
0030 51                       C     push cx
0031 52                       C     push dx
0032 33C9                     C     xor cx, cx
0034                          C divide_digit:
0034 33D2                     C     xor dx, dx             ; DIV uses DX:AX, not AX alone.
0036 F7F3                     C     div bx                 ; AX=quotient, DX=remainder.
0038 52                       C     push dx
0039 41                       C     inc cx
003A 83F800                   C     cmp ax, 0
003D 75F5                     C     jne divide_digit       ; Execute at least once, so zero prints as "0".
003F                          C output_digit:
003F 5A                       C     pop dx
0040 80FA09                   C     cmp dl, 9
0043 7605                     C     jbe numeric_digit
0045 80C237                   C     add dl, 'A'-10         ; Values 10..15 map to A..F.
0048 EB03                     C     jmp short emit_digit
004A                          C numeric_digit:
004A 80C230                   C     add dl, '0'
004D                          C emit_digit:
004D B402                     C     mov ah, 02h
004F CD21                     C     int 21h
0051 E2EC                     C     loop output_digit
0053 5A                       C     pop dx
0054 59                       C     pop cx
0055 58                       C     pop ax
0056 C3                       C     ret
0057                          C print_unsigned endp
                              C 
0057                          C print_newline proc near
0057 50                       C     push ax
0058 52                       C     push dx
0059 B20D                     C     mov dl, 0dh
005B B402                     C     mov ah, 02h
005D CD21                     C     int 21h
005F B20A                     C     mov dl, 0ah
0061 CD21                     C     int 21h
0063 5A                       C     pop dx
0064 58                       C     pop ax
0065 C3                       C     ret
0066                          C print_newline endp
                              C 
                              C ; DS:DX points to a DOS AH=0Ah line buffer.
                              C ; Return its unsigned decimal value (0..65535) in AX.
0066                          C read_decimal proc near
0066 B40A                     C     mov ah, 0ah
0068 CD21                     C     int 21h
006A 8BF2                     C     mov si, dx
006C 33C9                     C     xor cx, cx
006E 8A4C01                   C     mov cl, [si+1]         ; Number of input characters, excluding CR.
0071 83C602                   C     add si, 2
0074 33C0                     C     xor ax, ax
0076 BB0A00                   C     mov bx, 10
0079                          C read_digit:
0079 F7E3                     C     mul bx                 ; value = old value * 10 + next digit.
007B 33D2                     C     xor dx, dx
007D 8A14                     C     mov dl, [si]
007F 80EA30                   C     sub dl, '0'
0082 03C2                     C     add ax, dx
0084 46                       C     inc si
0085 E2F2                     C     loop read_digit
0087 C3                       C     ret
0088                          C read_decimal endp
                                end start


